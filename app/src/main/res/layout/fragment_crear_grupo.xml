<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragmento_crear_grupo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#5BC5A7" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo Grupo"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivGroupImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1A1A1A"
                android:padding="2dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
                app:strokeColor="#5BC5A7"
                app:strokeWidth="2dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                app:backgroundTint="#5BC5A7"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_input_add"
                app:tint="#000000" />
        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGroupName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="Nombre del grupo"
            app:boxStrokeColor="#5BC5A7"
            app:hintTextColor="#5BC5A7"
            app:layout_constraintTop_toBottomOf="@id/imageContainer">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtNombreGrupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvLabelType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Categoría"
            android:textColor="#5BC5A7"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilGroupName" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:checkedButton="@+id/btnTipoCasa"
            app:layout_constraintTop_toBottomOf="@id/tvLabelType"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipoCasa"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Casa"
                android:textAllCaps="false"
                android:textColor="@color/selector_text_toggle"
                android:paddingVertical="12dp"
                app:backgroundTint="@color/selector_background_toggle"
                app:icon="@android:drawable/ic_menu_directions"
                app:iconGravity="top"
                app:iconTint="@color/selector_text_toggle"
                app:strokeColor="#333333" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipoViaje"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Viaje"
                android:textAllCaps="false"
                android:textColor="@color/selector_text_toggle"
                android:paddingVertical="12dp"
                app:backgroundTint="@color/selector_background_toggle"
                app:icon="@android:drawable/ic_menu_compass"
                app:iconGravity="top"
                app:iconTint="@color/selector_text_toggle"
                app:strokeColor="#333333" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipoPareja"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pareja"
                android:textAllCaps="false"
                android:textColor="@color/selector_text_toggle"
                android:paddingVertical="12dp"
                app:backgroundTint="@color/selector_background_toggle"
                app:icon="@android:drawable/btn_star_big_on"
                app:iconGravity="top"
                app:iconTint="@color/selector_text_toggle"
                app:strokeColor="#333333" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipoOtro"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Otro"
                android:textAllCaps="false"
                android:textColor="@color/selector_text_toggle"
                android:paddingVertical="12dp"
                app:backgroundTint="@color/selector_background_toggle"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconGravity="top"
                app:iconTint="@color/selector_text_toggle"
                app:strokeColor="#333333" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearGrupo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="48dp"
            android:text="Crear Grupo"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#5BC5A7"
            app:cornerRadius="16dp"
            android:textColor="#000000"
            app:layout_constraintTop_toBottomOf="@id/toggleGroupType" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>