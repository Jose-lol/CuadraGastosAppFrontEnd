<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- LOGO / TITULO -->

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CuadraGastos"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestiona tus grupos fácilmente"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginBottom="40dp"/>

        <!-- CARD LOGIN -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#121212"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="#1F1F1F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- EMAIL -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Correo electrónico"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#1E1E1E"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:hintTextColor="#AAAAAA"
                    app:startIconDrawable="@android:drawable/ic_dialog_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAAAAA"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- PASSWORD -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Contraseña"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#1E1E1E"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="#AAAAAA"
                    app:startIconDrawable="@android:drawable/ic_lock_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAAAAA"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- LOGIN BUTTON -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:text="Iniciar sesión"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:backgroundTint="#5BC5A7"
                    app:cornerRadius="16dp"/>

                <!-- DIVIDER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#333333"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  o continúa con  "
                        android:textColor="#777777"
                        android:textSize="14sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#333333"/>
                </LinearLayout>

                <!-- GOOGLE LOGIN -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogleLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"

                    android:text="Continuar con Google"
                    android:textAllCaps="false"
                    android:textColor="#E3E3E3"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"

                    app:backgroundTint="#131314"
                    app:cornerRadius="20dp"

                    app:strokeColor="#8E918F"
                    app:strokeWidth="1dp"

                    app:icon="@drawable/logo_google"
                    app:iconTint="@null"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- REGISTER -->

        <TextView
            android:id="@+id/btnIrRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿No tienes cuenta? Regístrate"
            android:textColor="#5BC5A7"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp"/>

    </LinearLayout>

</ScrollView>